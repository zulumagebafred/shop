rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isPrimaryOwnerEmail() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'zulumagebafred@gmail.com';
    }

    function isOwnerEmail() {
      return isVerifiedUser() &&
        request.auth.token.email.lower() in [
          'zulumagebafred@gmail.com',
          'tese.khumalo@gmail.com',
          'ncedilekhoza@aurahutco.com',
          'nothando@aurahutco.com'
        ];
    }

    function isAdmin() {
      return isOwnerEmail() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // 3. Collection Rules

    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // Admin user management — primary owner only
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isPrimaryOwnerEmail() || (isVerifiedUser() && request.auth.uid == adminId));
      allow list: if isPrimaryOwnerEmail();
      allow create, update: if isPrimaryOwnerEmail() && isValidId(adminId);
      allow delete: if isPrimaryOwnerEmail() && isValidId(adminId);
    }

    // Perfumes — public read, admin write
    match /perfumes/{perfumeId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(perfumeId);
    }

    // Hampers — public read active, admin write
    match /hampers/{hamperId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(hamperId);
    }

    // Coupons — owner read, admin write
    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && (isOwnerEmail() || (resource != null && resource.data.active == true));
      allow list: if isOwnerEmail();
      allow create, update, delete: if isAdmin() && isValidId(couponId);
    }

    // Campaigns / Hero section — public read, admin write
    match /campaigns/{campaignId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(campaignId);
    }

    // Combos — public read active, admin write
    match /combos/{comboId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(comboId);
    }

    // Layering ideas — public read active, admin write
    match /layeringIdeas/{ideaId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(ideaId);
    }

    // Weekly specials — public read, admin write
    match /weeklySpecials/{specialId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if isAdmin() && isValidId(specialId);
    }

    // Referrals — owner + linked partner read, admin write
    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && (
        isOwnerEmail() ||
        (isVerifiedUser() && resource != null && 'partnerUid' in resource.data && resource.data.partnerUid == request.auth.uid)
      );
      allow list: if isOwnerEmail();
      allow create, update, delete: if isAdmin() && isValidId(referralId);
    }

    // Public referrals — public read active, admin write
    match /publicReferrals/{referralId} {
      allow get: if isValidId(referralId) && (isOwnerEmail() || (resource != null && resource.data.active == true));
      allow list: if isOwnerEmail();
      allow create, update, delete: if isAdmin() && isValidId(referralId);
    }

    // Referral attributions — owner read, admin + guest create, admin update/delete
    match /referralAttributions/{attributionId} {
      allow get: if isOwnerEmail();
      allow list: if isOwnerEmail();
      allow create: if isValidId(attributionId) && (isAdmin() || true);
      allow update, delete: if isAdmin() && isValidId(attributionId);
    }

    // Referral sales — owner + linked partner read, admin write
    match /referralSales/{saleId} {
      allow get: if isValidId(saleId) && (
        isOwnerEmail() ||
        (isVerifiedUser() && resource != null && 'partnerUid' in resource.data && resource.data.partnerUid == request.auth.uid)
      );
      allow list: if isOwnerEmail() || (
        isVerifiedUser() && 'partnerUid' in resource.data && resource.data.partnerUid == request.auth.uid
      );
      allow create, update, delete: if isAdmin() && isValidId(saleId);
    }

    // Referral partners — owner + self read, admin + self write
    match /referralPartners/{partnerId} {
      allow get: if isValidId(partnerId) && (
        isOwnerEmail() ||
        (isVerifiedUser() && request.auth.uid == partnerId)
      );
      allow list: if isOwnerEmail();
      allow create: if isVerifiedUser() && isValidId(partnerId) && request.auth.uid == partnerId;
      allow update: if isValidId(partnerId) && (
        isAdmin() ||
        (isVerifiedUser() && request.auth.uid == partnerId)
      );
      allow delete: if isAdmin() && isValidId(partnerId);
    }

    // Audit logs — owner read, admin create only
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isOwnerEmail();
      allow list: if isOwnerEmail();
      allow create: if isAdmin() && isValidId(logId);
      allow update: if false;
      allow delete: if false;
    }

    // Catalogue snapshots — public read, admin write
    match /catalogueSnapshots/{snapshotId} {
      allow get: if isValidId(snapshotId) && snapshotId == 'public';
      allow list: if false;
      allow create, update: if isAdmin() && isValidId(snapshotId) && snapshotId == 'public';
      allow delete: if isAdmin() && isValidId(snapshotId) && snapshotId == 'public';
    }
  }
}
