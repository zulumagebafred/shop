rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isPrimaryOwnerEmail() {
      return isVerifiedUser() && request.auth.token.email.lower() == 'zulumagebafred@gmail.com';
    }

    function isOwnerEmail() {
      return isVerifiedUser() &&
        request.auth.token.email.lower() in ['zulumagebafred@gmail.com', 'tese.khumalo@gmail.com'];
    }

    function isAdmin() {
      return isOwnerEmail() || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // 3. Entity Validation Helpers
    function isValidNoteList(notes) {
      return notes is list &&
        notes.size() <= 10 &&
        (notes.size() == 0 || (notes[0] is string && notes[0].size() <= 60)) &&
        (notes.size() <= 1 || (notes[1] is string && notes[1].size() <= 60)) &&
        (notes.size() <= 2 || (notes[2] is string && notes[2].size() <= 60));
    }

    function isValidSizeEntry(entry) {
      return entry is map &&
        entry.keys().hasAll(['size', 'price', 'available']) &&
        entry.keys().hasOnly(['size', 'price', 'available']) &&
        entry['size'] is string &&
        entry['size'].size() >= 1 &&
        entry['size'].size() <= 24 &&
        (entry['price'] == null || (entry['price'] is number && entry['price'] >= 0 && entry['price'] <= 100000)) &&
        entry['available'] is bool;
    }

    function isValidSizeList(sizes) {
      return sizes is list &&
        sizes.size() >= 1 &&
        sizes.size() <= 12 &&
        isValidSizeEntry(sizes[0]) &&
        (sizes.size() <= 1 || isValidSizeEntry(sizes[1])) &&
        (sizes.size() <= 2 || isValidSizeEntry(sizes[2]));
    }

    function isValidBranchList(branches) {
      return branches is list &&
        branches.size() <= 2 &&
        branches.hasOnly(['manzini', 'mbabane']);
    }

    function isValidSpecialSizeList(sizes) {
      return sizes is list &&
        sizes.size() <= 12 &&
        (sizes.size() == 0 || (sizes[0] is string && sizes[0].size() >= 1 && sizes[0].size() <= 24)) &&
        (sizes.size() <= 1 || (sizes[1] is string && sizes[1].size() >= 1 && sizes[1].size() <= 24)) &&
        (sizes.size() <= 2 || (sizes[2] is string && sizes[2].size() >= 1 && sizes[2].size() <= 24));
    }

    function isValidPerfume(data) {
      return data.keys().hasAll([
        'slug', 'isSampleListing', 'name', 'brand', 'category', 'concentration',
        'description', 'image', 'notes', 'sizes', 'availability', 'featured',
        'bestseller', 'onSpecial', 'specialLabel', 'specialDiscountPercent',
        'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'slug', 'isSampleListing', 'name', 'brand', 'category', 'concentration',
        'description', 'image', 'notes', 'sizes', 'availability', 'availableBranches', 'featured',
        'bestseller', 'onSpecial', 'specialLabel', 'specialDiscountType',
        'specialDiscountPercent', 'specialDiscountAmount', 'specialSizes',
        'isUnboxed', 'isNewArrival',
        'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 160 &&
      data.isSampleListing is bool &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
      data.brand is string && data.brand.size() >= 1 && data.brand.size() <= 100 &&
      data.category in ['Men', 'Women', 'Unisex', 'Kiddies'] &&
      data.concentration is string && data.concentration.size() >= 1 && data.concentration.size() <= 100 &&
      data.description is string && data.description.size() <= 2000 &&
      data.image is string && data.image.size() >= 1 && data.image.size() <= 500 &&
      data.notes is map &&
      data.notes.keys().hasAll(['top', 'heart', 'base']) &&
      data.notes.keys().hasOnly(['top', 'heart', 'base']) &&
      isValidNoteList(data.notes.top) &&
      isValidNoteList(data.notes.heart) &&
      isValidNoteList(data.notes.base) &&
      isValidSizeList(data.sizes) &&
      data.availability in ['In Stock', 'Low Stock', 'Out of Stock', 'Pre-Order'] &&
      (!('availableBranches' in data) || isValidBranchList(data.availableBranches)) &&
      data.featured is bool &&
      data.bestseller is bool &&
      data.onSpecial is bool &&
      data.specialLabel is string && data.specialLabel.size() <= 60 &&
      (!('specialDiscountType' in data) || data.specialDiscountType in ['percentage', 'fixed']) &&
      data.specialDiscountPercent is number && data.specialDiscountPercent >= 0 && data.specialDiscountPercent <= 90 &&
      (!('specialDiscountAmount' in data) || (data.specialDiscountAmount is number && data.specialDiscountAmount >= 0 && data.specialDiscountAmount <= 50000)) &&
      (!('specialSizes' in data) || isValidSpecialSizeList(data.specialSizes)) &&
      (!('isUnboxed' in data) || data.isUnboxed is bool) &&
      (!('isNewArrival' in data) || data.isNewArrival is bool) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHamper(data) {
      return data.keys().hasAll([
        'title', 'occasion', 'subtitle', 'itemsIncluded',
        'regularPrice', 'hamperPrice', 'image', 'giftWrapNote',
        'availability', 'featured', 'active', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'occasion', 'subtitle', 'itemsIncluded',
        'regularPrice', 'hamperPrice', 'image', 'giftWrapNote',
        'availability', 'featured', 'active', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
      data.occasion is string && data.occasion.size() >= 1 && data.occasion.size() <= 60 &&
      data.subtitle is string && data.subtitle.size() <= 300 &&
      data.itemsIncluded is list && data.itemsIncluded.size() >= 1 && data.itemsIncluded.size() <= 8 &&
      data.itemsIncluded[0] is string && data.itemsIncluded[0].size() >= 1 && data.itemsIncluded[0].size() <= 140 &&
      (data.itemsIncluded.size() <= 1 || (data.itemsIncluded[1] is string && data.itemsIncluded[1].size() >= 1 && data.itemsIncluded[1].size() <= 140)) &&
      (data.itemsIncluded.size() <= 2 || (data.itemsIncluded[2] is string && data.itemsIncluded[2].size() >= 1 && data.itemsIncluded[2].size() <= 140)) &&
      data.regularPrice is number && data.regularPrice >= 0 && data.regularPrice <= 100000 &&
      data.hamperPrice is number && data.hamperPrice >= 0 && data.hamperPrice <= 100000 &&
      data.hamperPrice <= data.regularPrice &&
      data.image is string && data.image.size() >= 1 && data.image.size() <= 500 &&
      data.giftWrapNote is string && data.giftWrapNote.size() <= 200 &&
      data.availability in ['In Stock', 'Low Stock', 'Out of Stock', 'Pre-Order'] &&
      data.featured is bool &&
      data.active is bool &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll([
        'code', 'description', 'discountType', 'discountValue',
        'minOrderAmount', 'appliesTo', 'active', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'code', 'description', 'discountType', 'discountValue',
        'minOrderAmount', 'appliesTo', 'active', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.code is string && data.code.size() >= 2 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9_\\-]+$') &&
      data.description is string && data.description.size() <= 200 &&
      data.discountType in ['percentage', 'fixed'] &&
      data.discountValue is number && data.discountValue > 0 && data.discountValue <= 50000 &&
      (data.discountType == 'fixed' || data.discountValue <= 95) &&
      data.minOrderAmount is number && data.minOrderAmount >= 0 && data.minOrderAmount <= 100000 &&
      data.appliesTo in ['all', 'specials', 'full-bottles'] &&
      data.active is bool &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCampaign(data) {
      return data.keys().hasAll([
        'title', 'badgeText', 'subtitle', 'announcementText',
        'promoCodeHint', 'endsAt', 'enabled', 'ownerUid', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'badgeText', 'subtitle', 'announcementText',
        'promoCodeHint', 'endsAt', 'enabled',
        'heroMode', 'newArrivalsTitle', 'newArrivalsBadge', 'newArrivalsSubtitle',
        'ownerUid', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
      data.badgeText is string && data.badgeText.size() >= 1 && data.badgeText.size() <= 40 &&
      data.subtitle is string && data.subtitle.size() <= 400 &&
      data.announcementText is string && data.announcementText.size() <= 240 &&
      data.promoCodeHint is string && data.promoCodeHint.size() <= 32 &&
      data.endsAt is string && data.endsAt.size() <= 64 &&
      data.enabled is bool &&
      (!('heroMode' in data) || data.heroMode in ['auto', 'specials', 'new-arrivals']) &&
      (!('newArrivalsTitle' in data) || (data.newArrivalsTitle is string && data.newArrivalsTitle.size() <= 100)) &&
      (!('newArrivalsBadge' in data) || (data.newArrivalsBadge is string && data.newArrivalsBadge.size() <= 40)) &&
      (!('newArrivalsSubtitle' in data) || (data.newArrivalsSubtitle is string && data.newArrivalsSubtitle.size() <= 400)) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['email', 'role', 'createdAt', 'updatedAt']) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.role in ['owner', 'manager'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCombo(data) {
      return data.keys().hasAll([
        'title', 'subtitle', 'perfumeNames', 'sizeLabel',
        'regularPrice', 'comboPrice', 'tag', 'featured', 'active',
        'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'subtitle', 'perfumeNames', 'sizeLabel',
        'regularPrice', 'comboPrice', 'tag', 'featured', 'active',
        'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
      data.subtitle is string && data.subtitle.size() <= 300 &&
      data.perfumeNames is list && data.perfumeNames.size() >= 2 && data.perfumeNames.size() <= 6 &&
      data.perfumeNames[0] is string && data.perfumeNames[0].size() >= 1 && data.perfumeNames[0].size() <= 140 &&
      data.perfumeNames[1] is string && data.perfumeNames[1].size() >= 1 && data.perfumeNames[1].size() <= 140 &&
      (data.perfumeNames.size() <= 2 || (data.perfumeNames[2] is string && data.perfumeNames[2].size() >= 1 && data.perfumeNames[2].size() <= 140)) &&
      data.sizeLabel is string && data.sizeLabel.size() >= 1 && data.sizeLabel.size() <= 60 &&
      data.regularPrice is number && data.regularPrice >= 0 && data.regularPrice <= 100000 &&
      data.comboPrice is number && data.comboPrice >= 0 && data.comboPrice <= 100000 &&
      data.comboPrice <= data.regularPrice &&
      data.tag is string && data.tag.size() <= 40 &&
      data.featured is bool &&
      data.active is bool &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLayeringIdea(data) {
      return data.keys().hasAll([
        'title', 'vibe', 'basePerfumeName', 'topPerfumeName',
        'sprayRatio', 'occasion', 'whyItWorks', 'active',
        'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'vibe', 'basePerfumeName', 'topPerfumeName',
        'sprayRatio', 'occasion', 'whyItWorks', 'active',
        'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
      data.vibe is string && data.vibe.size() >= 1 && data.vibe.size() <= 60 &&
      data.basePerfumeName is string && data.basePerfumeName.size() >= 1 && data.basePerfumeName.size() <= 140 &&
      data.topPerfumeName is string && data.topPerfumeName.size() >= 1 && data.topPerfumeName.size() <= 140 &&
      data.sprayRatio is string && data.sprayRatio.size() >= 1 && data.sprayRatio.size() <= 80 &&
      data.occasion is string && data.occasion.size() <= 120 &&
      data.whyItWorks is string && data.whyItWorks.size() >= 1 && data.whyItWorks.size() <= 500 &&
      data.active is bool &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidWeeklyPickList(ids) {
      return ids is list &&
        ids.size() <= 3 &&
        (ids.size() == 0 || isValidId(ids[0])) &&
        (ids.size() < 2 || isValidId(ids[1])) &&
        (ids.size() < 3 || isValidId(ids[2]));
    }

    function isValidWeeklyUnder500List(ids) {
      return ids is list &&
        ids.size() <= 3 &&
        (ids.size() == 0 || isValidId(ids[0])) &&
        (ids.size() < 2 || isValidId(ids[1])) &&
        (ids.size() < 3 || isValidId(ids[2]));
    }

    function isValidExclusiveFiveMlEntry(entry) {
      return entry is map &&
        entry.keys().hasAll(['perfumeId', 'customPrice']) &&
        entry.keys().hasOnly(['perfumeId', 'customPrice', 'sizeLabel']) &&
        isValidId(entry.perfumeId) &&
        entry.customPrice is number &&
        entry.customPrice >= 1 &&
        entry.customPrice <= 50000 &&
        (!('sizeLabel' in entry) || (entry.sizeLabel is string && entry.sizeLabel.size() >= 1 && entry.sizeLabel.size() <= 40));
    }

    function isValidExclusiveFiveMlList(items) {
      return items is list &&
        items.size() <= 6 &&
        (items.size() == 0 || isValidExclusiveFiveMlEntry(items[0])) &&
        (items.size() < 2 || isValidExclusiveFiveMlEntry(items[1])) &&
        (items.size() < 3 || isValidExclusiveFiveMlEntry(items[2])) &&
        (items.size() < 4 || isValidExclusiveFiveMlEntry(items[3])) &&
        (items.size() < 5 || isValidExclusiveFiveMlEntry(items[4])) &&
        (items.size() < 6 || isValidExclusiveFiveMlEntry(items[5]));
    }

    function isValidWeeklySpecial(data) {
      return data.keys().hasAll([
        'enabled', 'autoRotateWeekly', 'weekKey', 'seedOffset',
        'under500Ids', 'under800Ids', 'fourPackPrice', 'twoPackPrice',
        'ownerUid', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'enabled', 'autoRotateWeekly', 'weekKey', 'seedOffset',
        'under500Ids', 'under800Ids',
        'womenUnder500Ids', 'womenUnder800Ids',
        'menUnder500Ids', 'menUnder800Ids',
        'fourPackPrice', 'twoPackPrice',
        'exclusiveEnabled', 'exclusiveTitle', 'exclusiveBadge', 'exclusiveSubtitle',
        'exclusiveBundleEnabled', 'exclusiveBundlePrice', 'exclusiveItems',
        'ownerUid', 'updatedAt'
      ]) &&
      data.enabled is bool &&
      data.autoRotateWeekly is bool &&
      data.weekKey is string && data.weekKey.size() >= 1 && data.weekKey.size() <= 24 &&
      data.seedOffset is number && data.seedOffset >= 0 && data.seedOffset <= 1000000 &&
      isValidWeeklyUnder500List(data.under500Ids) &&
      isValidWeeklyPickList(data.under800Ids) &&
      (!('womenUnder500Ids' in data) || isValidWeeklyUnder500List(data.womenUnder500Ids)) &&
      (!('womenUnder800Ids' in data) || isValidWeeklyPickList(data.womenUnder800Ids)) &&
      (!('menUnder500Ids' in data) || isValidWeeklyUnder500List(data.menUnder500Ids)) &&
      (!('menUnder800Ids' in data) || isValidWeeklyPickList(data.menUnder800Ids)) &&
      data.fourPackPrice is number && data.fourPackPrice >= 1 && data.fourPackPrice <= 10000 &&
      data.twoPackPrice is number && data.twoPackPrice >= 1 && data.twoPackPrice <= 10000 &&
      data.twoPackPrice <= data.fourPackPrice &&
      (!('exclusiveEnabled' in data) || data.exclusiveEnabled is bool) &&
      (!('exclusiveTitle' in data) || (data.exclusiveTitle is string && data.exclusiveTitle.size() <= 100)) &&
      (!('exclusiveBadge' in data) || (data.exclusiveBadge is string && data.exclusiveBadge.size() <= 40)) &&
      (!('exclusiveSubtitle' in data) || (data.exclusiveSubtitle is string && data.exclusiveSubtitle.size() <= 240)) &&
      (!('exclusiveBundleEnabled' in data) || data.exclusiveBundleEnabled is bool) &&
      (!('exclusiveBundlePrice' in data) || (data.exclusiveBundlePrice is number && data.exclusiveBundlePrice >= 0 && data.exclusiveBundlePrice <= 50000)) &&
      (!('exclusiveItems' in data) || isValidExclusiveFiveMlList(data.exclusiveItems)) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.updatedAt is timestamp;
    }

    function isValidReferral(data) {
      return data.keys().hasAll([
        'code', 'influencerName', 'socialHandle', 'commissionType', 'commissionValue',
        'followerDiscountType', 'followerDiscountValue', 'payoutNote', 'active',
        'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'code', 'influencerName', 'socialHandle', 'commissionType', 'commissionValue',
        'followerDiscountType', 'followerDiscountValue', 'payoutNote', 'active',
        'partnerUid', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.code is string && data.code.size() >= 2 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9_\\-]+$') &&
      data.influencerName is string && data.influencerName.size() >= 1 && data.influencerName.size() <= 120 &&
      data.socialHandle is string && data.socialHandle.size() <= 100 &&
      data.commissionType in ['percentage', 'fixed'] &&
      data.commissionValue is number && data.commissionValue >= 0 && data.commissionValue <= 50000 &&
      (data.commissionType == 'fixed' || data.commissionValue <= 90) &&
      data.followerDiscountType in ['none', 'percentage', 'fixed'] &&
      data.followerDiscountValue is number && data.followerDiscountValue >= 0 && data.followerDiscountValue <= 50000 &&
      (data.followerDiscountType != 'none' || data.followerDiscountValue == 0) &&
      (data.followerDiscountType != 'percentage' || data.followerDiscountValue <= 95) &&
      data.payoutNote is string && data.payoutNote.size() <= 200 &&
      data.active is bool &&
      (!('partnerUid' in data) || (data.partnerUid is string && data.partnerUid.size() <= 128 && data.partnerUid.matches('^[a-zA-Z0-9_\\-]*$'))) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPublicReferral(data) {
      return data.keys().hasAll([
        'code', 'influencerName', 'socialHandle',
        'followerDiscountType', 'followerDiscountValue', 'active',
        'ownerUid', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'code', 'influencerName', 'socialHandle',
        'followerDiscountType', 'followerDiscountValue', 'active',
        'ownerUid', 'updatedAt'
      ]) &&
      data.code is string && data.code.size() >= 2 && data.code.size() <= 32 && data.code.matches('^[A-Z0-9_\\-]+$') &&
      data.influencerName is string && data.influencerName.size() >= 1 && data.influencerName.size() <= 120 &&
      data.socialHandle is string && data.socialHandle.size() <= 100 &&
      data.followerDiscountType in ['none', 'percentage', 'fixed'] &&
      data.followerDiscountValue is number && data.followerDiscountValue >= 0 && data.followerDiscountValue <= 50000 &&
      (data.followerDiscountType != 'none' || data.followerDiscountValue == 0) &&
      (data.followerDiscountType != 'percentage' || data.followerDiscountValue <= 95) &&
      data.active is bool &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.updatedAt is timestamp;
    }

    function isValidReferralAttribution(data) {
      return data.keys().hasAll([
        'referralCode', 'influencerName', 'orderSummary',
        'reportedSubtotal', 'reportedDiscount', 'customerRef',
        'status', 'convertedSaleId', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'referralCode', 'influencerName', 'orderSummary',
        'reportedSubtotal', 'reportedDiscount', 'customerRef',
        'status', 'convertedSaleId', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.referralCode is string && data.referralCode.size() >= 2 && data.referralCode.size() <= 32 && data.referralCode.matches('^[A-Z0-9_\\-]+$') &&
      data.influencerName is string && data.influencerName.size() >= 1 && data.influencerName.size() <= 120 &&
      data.orderSummary is string && data.orderSummary.size() >= 1 && data.orderSummary.size() <= 240 &&
      data.reportedSubtotal is number && data.reportedSubtotal >= 0 && data.reportedSubtotal <= 250000 &&
      data.reportedDiscount is number && data.reportedDiscount >= 0 && data.reportedDiscount <= data.reportedSubtotal &&
      data.customerRef is string && data.customerRef.size() <= 120 &&
      data.status in ['pending', 'converted', 'dismissed'] &&
      data.convertedSaleId is string && data.convertedSaleId.size() <= 128 &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidReferralSale(data) {
      return data.keys().hasAll([
        'referralCode', 'influencerName', 'orderSummary', 'orderSubtotal', 'discountAmount',
        'netOrderAmount', 'commissionAmount', 'commissionStatus', 'source', 'customerRef',
        'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'referralCode', 'influencerName', 'orderSummary', 'orderSubtotal', 'discountAmount',
        'netOrderAmount', 'commissionAmount', 'commissionStatus', 'source', 'customerRef',
        'partnerUid', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.referralCode is string && data.referralCode.size() >= 2 && data.referralCode.size() <= 32 && data.referralCode.matches('^[A-Z0-9_\\-]+$') &&
      data.influencerName is string && data.influencerName.size() >= 1 && data.influencerName.size() <= 120 &&
      data.orderSummary is string && data.orderSummary.size() >= 1 && data.orderSummary.size() <= 240 &&
      data.orderSubtotal is number && data.orderSubtotal >= 0 && data.orderSubtotal <= 250000 &&
      data.discountAmount is number && data.discountAmount >= 0 && data.discountAmount <= data.orderSubtotal &&
      data.netOrderAmount is number && data.netOrderAmount >= 0 && data.netOrderAmount <= data.orderSubtotal &&
      data.commissionAmount is number && data.commissionAmount >= 0 && data.commissionAmount <= 100000 &&
      data.commissionStatus in ['pending', 'confirmed', 'paid', 'cancelled'] &&
      data.source in ['checkout', 'manual'] &&
      data.customerRef is string && data.customerRef.size() <= 120 &&
      (!('partnerUid' in data) || (data.partnerUid is string && data.partnerUid.size() <= 128 && data.partnerUid.matches('^[a-zA-Z0-9_\\-]*$'))) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidReferralPartner(data) {
      return data.keys().hasAll([
        'uid', 'email', 'displayName', 'socialHandle', 'requestedCode', 'assignedCode',
        'payoutMethod', 'payoutAccount', 'status', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'email', 'displayName', 'socialHandle', 'requestedCode', 'assignedCode',
        'payoutMethod', 'payoutAccount', 'status', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.uid) &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.socialHandle is string && data.socialHandle.size() <= 100 &&
      data.requestedCode is string && data.requestedCode.size() >= 2 && data.requestedCode.size() <= 32 && data.requestedCode.matches('^[A-Z0-9_\\-]+$') &&
      data.assignedCode is string && data.assignedCode.size() <= 32 &&
      (data.assignedCode == '' || (data.assignedCode.size() >= 2 && data.assignedCode.matches('^[A-Z0-9_\\-]+$'))) &&
      data.payoutMethod in ['momo', 'bank', 'store-credit'] &&
      data.payoutAccount is string && data.payoutAccount.size() <= 160 &&
      data.status in ['pending', 'active', 'paused'] &&
      isValidId(data.ownerUid) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAuditChangesList(changes) {
      return changes is list &&
        changes.size() <= 12 &&
        (changes.size() == 0 || (changes[0] is string && changes[0].size() >= 1 && changes[0].size() <= 220)) &&
        (changes.size() <= 1 || (changes[1] is string && changes[1].size() >= 1 && changes[1].size() <= 220)) &&
        (changes.size() <= 2 || (changes[2] is string && changes[2].size() >= 1 && changes[2].size() <= 220));
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
        'actorEmail', 'actorUsername', 'action', 'section',
        'targetId', 'targetLabel', 'summary', 'changes',
        'ownerUid', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'actorEmail', 'actorUsername', 'action', 'section',
        'targetId', 'targetLabel', 'summary', 'changes',
        'ownerUid', 'createdAt'
      ]) &&
      data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160 &&
      data.actorUsername is string && data.actorUsername.size() >= 1 && data.actorUsername.size() <= 80 &&
      data.action in ['create', 'update', 'delete', 'import'] &&
      data.section in [
        'perfume', 'specials', 'weekly-special', 'coupon',
        'combo', 'layering', 'hamper', 'referral', 'referral-sale', 'referral-attribution', 'referral-partner'
      ] &&
      data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 160 &&
      data.targetLabel is string && data.targetLabel.size() >= 1 && data.targetLabel.size() <= 160 &&
      data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300 &&
      isValidAuditChangesList(data.changes) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp;
    }

    function isValidCatalogueSnapshot(data) {
      return data.keys().hasAll([
        'version', 'totalCount', 'itemsJson', 'ownerUid', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'version', 'totalCount', 'itemsJson', 'ownerUid', 'updatedAt'
      ]) &&
      data.version is number && data.version >= 1 && data.version <= 100 &&
      data.totalCount is number && data.totalCount >= 0 && data.totalCount <= 5000 &&
      data.itemsJson is string && data.itemsJson.size() >= 2 && data.itemsJson.size() <= 900000 &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isPrimaryOwnerEmail() || (isVerifiedUser() && request.auth.uid == adminId));
      allow list: if isPrimaryOwnerEmail();
      allow create: if isPrimaryOwnerEmail() &&
        isValidId(adminId) &&
        isValidAdmin(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isPrimaryOwnerEmail() &&
        isValidId(adminId) &&
        isValidAdmin(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']);
      allow delete: if isPrimaryOwnerEmail() && isValidId(adminId);
    }

    match /perfumes/{perfumeId} {
      allow get: if isValidId(perfumeId);
      allow list: if isOwnerEmail() || existing().availability in ['In Stock', 'Low Stock', 'Out of Stock', 'Pre-Order'];
      allow create: if isAdmin() &&
        isValidId(perfumeId) &&
        isValidPerfume(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(perfumeId) &&
        isValidPerfume(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'isSampleListing', 'name', 'brand', 'category', 'concentration',
          'description', 'image', 'notes', 'sizes', 'availability', 'availableBranches', 'featured',
          'bestseller', 'onSpecial', 'specialLabel', 'specialDiscountType',
          'specialDiscountPercent', 'specialDiscountAmount', 'specialSizes',
          'isUnboxed', 'isNewArrival', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(perfumeId);
    }

    match /hampers/{hamperId} {
      allow get: if isValidId(hamperId) && (isOwnerEmail() || existing().active == true);
      allow list: if isOwnerEmail() || existing().active == true;
      allow create: if isAdmin() &&
        isValidId(hamperId) &&
        isValidHamper(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(hamperId) &&
        isValidHamper(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'occasion', 'subtitle', 'itemsIncluded',
          'regularPrice', 'hamperPrice', 'image', 'giftWrapNote',
          'availability', 'featured', 'active', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(hamperId);
    }

    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && (isOwnerEmail() || (resource != null && existing().active == true));
      allow list: if isOwnerEmail();
      allow create: if isAdmin() &&
        isValidId(couponId) &&
        isValidCoupon(incoming()) &&
        incoming().code == couponId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(couponId) &&
        isValidCoupon(incoming()) &&
        incoming().code == existing().code &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'description', 'discountType', 'discountValue',
          'minOrderAmount', 'appliesTo', 'active', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(couponId);
    }

    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId);
      allow list: if isOwnerEmail();
      allow create: if isAdmin() &&
        isValidId(campaignId) &&
        isValidCampaign(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(campaignId) &&
        isValidCampaign(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'badgeText', 'subtitle', 'announcementText',
          'promoCodeHint', 'endsAt', 'enabled',
          'heroMode', 'newArrivalsTitle', 'newArrivalsBadge', 'newArrivalsSubtitle',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(campaignId);
    }

    match /combos/{comboId} {
      allow get: if isValidId(comboId) && (isOwnerEmail() || existing().active == true);
      allow list: if isOwnerEmail() || existing().active == true;
      allow create: if isAdmin() &&
        isValidId(comboId) &&
        isValidCombo(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(comboId) &&
        isValidCombo(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subtitle', 'perfumeNames', 'sizeLabel',
          'regularPrice', 'comboPrice', 'tag', 'featured', 'active', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(comboId);
    }

    match /layeringIdeas/{ideaId} {
      allow get: if isValidId(ideaId) && (isOwnerEmail() || existing().active == true);
      allow list: if isOwnerEmail() || existing().active == true;
      allow create: if isAdmin() &&
        isValidId(ideaId) &&
        isValidLayeringIdea(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(ideaId) &&
        isValidLayeringIdea(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'vibe', 'basePerfumeName', 'topPerfumeName',
          'sprayRatio', 'occasion', 'whyItWorks', 'active', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(ideaId);
    }

    match /weeklySpecials/{specialId} {
      allow get: if isValidId(specialId);
      allow list: if isOwnerEmail();
      allow create: if isAdmin() &&
        isValidId(specialId) &&
        isValidWeeklySpecial(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(specialId) &&
        isValidWeeklySpecial(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'enabled', 'autoRotateWeekly', 'weekKey', 'seedOffset',
          'under500Ids', 'under800Ids',
          'womenUnder500Ids', 'womenUnder800Ids',
          'menUnder500Ids', 'menUnder800Ids',
          'fourPackPrice', 'twoPackPrice',
          'exclusiveEnabled', 'exclusiveTitle', 'exclusiveBadge', 'exclusiveSubtitle',
          'exclusiveBundleEnabled', 'exclusiveBundlePrice', 'exclusiveItems',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(specialId);
    }

    // Private influencer referral configuration (readable by store admins or linked partnerUid)
    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && (
        isOwnerEmail() ||
        (isVerifiedUser() && resource != null && 'partnerUid' in existing() && existing().partnerUid == request.auth.uid)
      );
      allow list: if isOwnerEmail();
      allow create: if isAdmin() &&
        isValidId(referralId) &&
        isValidReferral(incoming()) &&
        incoming().code == referralId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(referralId) &&
        isValidReferral(incoming()) &&
        incoming().code == existing().code &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'influencerName', 'socialHandle', 'commissionType', 'commissionValue',
          'followerDiscountType', 'followerDiscountValue', 'payoutNote', 'active', 'partnerUid', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(referralId);
    }

    // Public active-only referral projection for storefront follower benefit lookups (zero commission/payout fields)
    match /publicReferrals/{referralId} {
      allow get: if isValidId(referralId) && (isOwnerEmail() || (resource != null && existing().active == true));
      allow list: if isOwnerEmail();
      allow create: if isAdmin() &&
        isValidId(referralId) &&
        isValidPublicReferral(incoming()) &&
        incoming().code == referralId &&
        incoming().ownerUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(referralId) &&
        isValidPublicReferral(incoming()) &&
        incoming().code == existing().code &&
        incoming().ownerUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'influencerName', 'socialHandle',
          'followerDiscountType', 'followerDiscountValue', 'active', 'ownerUid', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(referralId);
    }

    // Write-once checkout attributions submitted at WhatsApp handoff; no trusted commission fields
    match /referralAttributions/{attributionId} {
      allow get: if isOwnerEmail();
      allow list: if isOwnerEmail();
      allow create: if isValidId(attributionId) &&
        !exists(/databases/$(database)/documents/referralAttributions/$(attributionId)) &&
        isValidReferralAttribution(incoming()) &&
        incoming().status == 'pending' &&
        incoming().convertedSaleId == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/publicReferrals/$(incoming().referralCode)) &&
        get(/databases/$(database)/documents/publicReferrals/$(incoming().referralCode)).data.active == true &&
        (
          (isAdmin() && incoming().ownerUid == request.auth.uid) ||
          incoming().ownerUid == 'guest-checkout'
        );
      allow update: if isAdmin() &&
        isValidId(attributionId) &&
        isValidReferralAttribution(incoming()) &&
        incoming().referralCode == existing().referralCode &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'convertedSaleId', 'reportedSubtotal', 'reportedDiscount', 'customerRef', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(attributionId);
    }

    // Authoritative commission ledger written strictly by store admins; readable by admins or scoped partnerUid
    match /referralSales/{saleId} {
      allow get: if isValidId(saleId) && (
        isOwnerEmail() ||
        (isVerifiedUser() && resource != null && 'partnerUid' in existing() && existing().partnerUid == request.auth.uid)
      );
      allow list: if isOwnerEmail() || (
        isVerifiedUser() && 'partnerUid' in resource.data && resource.data.partnerUid == request.auth.uid
      );
      allow create: if isAdmin() &&
        isValidId(saleId) &&
        isValidReferralSale(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/referrals/$(incoming().referralCode));
      allow update: if isAdmin() &&
        isValidId(saleId) &&
        isValidReferralSale(incoming()) &&
        incoming().referralCode == existing().referralCode &&
        incoming().source == existing().source &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'influencerName', 'orderSummary', 'orderSubtotal', 'discountAmount',
          'netOrderAmount', 'commissionAmount', 'commissionStatus', 'customerRef', 'partnerUid', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(saleId);
    }

    // Referral partner creator onboarding & payout profiles keyed by Firebase Auth UID
    match /referralPartners/{partnerId} {
      allow get: if isValidId(partnerId) && (
        isOwnerEmail() ||
        (isVerifiedUser() && request.auth.uid == partnerId)
      );
      allow list: if isOwnerEmail();
      allow create: if isVerifiedUser() &&
        isValidId(partnerId) &&
        request.auth.uid == partnerId &&
        isValidReferralPartner(incoming()) &&
        incoming().uid == partnerId &&
        incoming().email.lower() == request.auth.token.email.lower() &&
        incoming().ownerUid == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().assignedCode == '' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(partnerId) &&
        isValidReferralPartner(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'socialHandle', 'requestedCode', 'assignedCode',
              'payoutMethod', 'payoutAccount', 'status', 'updatedAt'
            ])
          ) ||
          (
            isVerifiedUser() &&
            request.auth.uid == partnerId &&
            incoming().status == existing().status &&
            incoming().assignedCode == existing().assignedCode &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'socialHandle', 'requestedCode',
              'payoutMethod', 'payoutAccount', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(partnerId);
    }

    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isOwnerEmail();
      allow list: if isOwnerEmail();
      allow create: if isAdmin() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().actorEmail.lower() == request.auth.token.email.lower() &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /catalogueSnapshots/{snapshotId} {
      allow get: if isValidId(snapshotId) && snapshotId == 'public';
      allow list: if false;
      allow create: if isAdmin() &&
        isValidId(snapshotId) &&
        snapshotId == 'public' &&
        isValidCatalogueSnapshot(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(snapshotId) &&
        snapshotId == 'public' &&
        isValidCatalogueSnapshot(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'version', 'totalCount', 'itemsJson', 'ownerUid', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(snapshotId) && snapshotId == 'public';
    }
  }
}
